- name: phase_correct_hopping_0
  id: phase_correct_hopping
  parameters:
    affinity: ''
    alias: ''
    cal_file: '""'
    comment: 'Removes the fixed inter-channel offset, per band. Measured 2026-09-24 through this same
      radio configuration -- gains 46/60/69 and gain_trim (0, -13.3, 1.5, -1.7) -- because RX gain shifts
      phase here, so a table measured any other way does not apply. Verified: residuals -0.05..+0.23 deg
      on all three bands, against a measurement noise floor of 0.2-0.3 deg.

      VALID FOR THIS POWER SESSION ONLY. The LO dividers relock to a new phase every time the X310 is
      power cycled; re-run phase_table_measure.py after one, or these numbers silently correct to the
      wrong place.'
    deg_0: (175.90, -86.62, -168.03)
    deg_1: (111.43, 71.93, 35.91)
    deg_2: (82.66, 155.54, 173.74)
    deg_3: (0.0, 0.0, 0.0)
    deg_4: (0.0, 0.0, 0.0)
    deg_5: (0.0, 0.0, 0.0)
    deg_6: (0.0, 0.0, 0.0)
    deg_7: (0.0, 0.0, 0.0)
    dwell_0: '10'
    dwell_1: '10'
    dwell_2: '10'
    dwell_3: '10'
    dwell_4: '10'
    dwell_5: '10'
    dwell_6: '10'
    dwell_7: '10'
    follow_source: 'True'
    freq_0: '2400000000.0'
    freq_1: '5200000000.0'
    freq_2: '5800000000.0'
    freq_3: '2400000000'
    freq_4: '2400000000'
    freq_5: '2400000000'
    freq_6: '2400000000'
    freq_7: '2400000000'
    freq_tol: '1000000'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_bands: '3'
    num_channels: '4'
    settle: '1.0'
    start_delay: '2.0'
    follow_tags: 'True'
  states:
