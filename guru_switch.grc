options:
  parameters:
    author: shankar
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: 'USRP-2945 (X310 + 2x TwinRX) LO configuration and phase-coherence test.

      GNU Radio 3.8 / UHD 3.15.

      All four channels are driven from ONE synthesiser, tuned with timed commands.'
    copyright: ''
    description: TwinRX LO sharing / phase coherence test bench
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: guru_switch
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'Guru SWITCH: USRP-2945 DF (shared LO, 5 ms / 7 ms hopping) + MON (own LO per channel), switched
      on the radio clock'
    window_size: 1400,900
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: avg_len
  id: variable
  parameters:
    comment: 'Coherent averaging length for the phase estimate.

      65536 samples = 65 ms at 1 Msps, comparable to what

      twinrx_lo_check.py integrates. The old 4096 averaged 24x

      less and made the GUI look far noisier than the CLI for

      the same signal.'
    value: '65536'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 344
    - 116.0
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    comment: 'Reported by the hopping block, not a control any more.

      The band list lives in the TwinRX Hopping USRP Source block.'
    value: tone_band
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 944
    - 124.0
    rotation: 0
    state: enabled
- name: cmd_lead
  id: variable
  parameters:
    comment: 'How far ahead of "now" the timed tune is scheduled.

      Must exceed the host->FPGA latency. 0.1 s is safe.'
    value: '0.1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 284.0
    rotation: 0
    state: enabled
- name: disp_bw
  id: variable
  parameters:
    comment: 'Wide enough to keep the tone when the transmitter''s crystal is off

      frequency. The HackRF is ~+/-20 ppm, which is ~116 kHz at 5.8 GHz,

      so the old 20 kHz window would have rejected it entirely.'
    value: 300e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1000
    - 8
    rotation: 0
    state: enabled
- name: disp_gain
  id: variable
  parameters:
    comment: 'Fixed display gain for ch2/ch3.

      Replaces the AGC: the tone is already steady to ~0.6%, so no

      automatic gain is needed.  A fixed gain keeps the true relative

      amplitude between channels and has no start-up transient.'
    value: '25'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1240
    - 8
    rotation: 0
    state: enabled
- name: disp_interp_trans
  id: variable
  parameters:
    comment: 'Transition width of the display interpolator''s anti-imaging filter.


      time_resamp_N interpolates 1 Msps up to time_srate purely so the time

      plot draws a smooth waveform. The filter only has to reject the images

      of the interpolated stream: the signal reaches disp_bw, the first image

      starts at samp_rate - disp_bw, so everything between the two is

      transition band and nothing is gained by making it narrower.


      It was fixed at 50 kHz, eight times tighter than that. Hamming taps go

      as 3.3 * fs / transition, so 50 kHz meant ~1320 taps running at 20 Msps

      on four channels -- 5.3 GMAC/s, measured as 527% CPU and a load average

      of 16 on a 12 core host, for a picture. A starved host is what makes

      the X310''s RFNoC control acks time out, which is what kills the stream.'
    value: samp_rate - 2 * disp_bw
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1000
    - 80
    rotation: 0
    state: enabled
- name: disp_taps_bp
  id: variable
  parameters:
    comment: 'One-sided: the tone always arrives on the positive side.

      Bands whose receive chain inverts the spectrum are pre-compensated at

      the transmitter -- 5.1 GHz is sent a -200 kHz tone so it still lands at

      +200 kHz (see --offset-map). Widening the filter to cover both sides

      would work too, but costs 3 dB of noise bandwidth to paper over

      something better fixed at the source.'
    value: firdes.complex_band_pass(1.0, samp_rate, tone_offset - disp_bw/2, tone_offset + disp_bw/2,
      disp_bw/4, firdes.WIN_HAMMING)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1120
    - 8
    rotation: 0
    state: enabled
- name: dsp_manual
  id: variable
  parameters:
    comment: 'True  -> force every DDC to 0 Hz so the digital

      down-conversion adds no per-channel phase.

      Set False if you need exact requested centre freq.'
    value: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 356.0
    rotation: 0
    state: enabled
- name: lo_export_chan
  id: variable
  parameters:
    comment: 'Channel whose synthesiser feeds everything else.

      0 = DB-A ch0 exports (cables A->B)  -- NOT WORKING on this unit

      2 = DB-B ch0 exports (cables B->A)  -- verified working'
    value: '2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 116.0
    rotation: 0
    state: enabled
- name: lo_sources
  id: variable
  parameters:
    comment: 'Per-channel LO source, index = UHD channel.

      Master board : exporter = internal (or reimport), partner = companion

      Slave  board : BOTH channels = external

      Valid: internal / companion / external / reimport / disabled

      Rx B exports here, not Rx A. Measured on this unit the jumpers

      carrying A LO-out to B LO-in pass nothing, while B to A works.

      Swap back to [internal, companion, external, external] with

      lo_export_chan 0 if those cables get repaired.'
    value: '[''external'', ''external'', ''internal'', ''companion'']'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 188.0
    rotation: 0
    state: enabled
- name: ph_avg
  id: variable
  parameters:
    comment: Averaging length for the displayed phase.
    value: '16384'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 248
    - 36.0
    rotation: 0
    state: enabled
- name: ph_skip
  id: variable
  parameters:
    comment: 'Samples skipped before measuring, so the reading is

      past the start-up transient.'
    value: 2**13
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 120
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: 'Per-channel rate. 1 Msps x 4ch is easy on 10GbE

      and plenty for a phase-coherence check.'
    value: '2000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 116.0
    rotation: 0
    state: enabled
- name: stream_state
  id: variable_qtgui_label
  parameters:
    comment: 'Says on screen whether the radio is actually sending.

      When the stream dies the traces hold their last value,

      which looks like a steady reading rather than no reading.

      The snippet below drives this from the block''s watchdog.'
    formatter: None
    gui_hint: tabs@0:3,0,1,3
    label: STREAM
    type: string
    value: '''receiving'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1384
    - 444.0
    rotation: 0
    state: enabled
- name: subdev
  id: variable
  parameters:
    comment: 'DB-A = TwinRX #1 (ch0, ch1)

      DB-B = TwinRX #2 (ch2, ch3)'
    value: '"A:0 A:1 B:0 B:1"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 180.0
    rotation: 0
    state: enabled
- name: time_interp
  id: variable
  parameters:
    comment: Interpolation factor for time domain block
    value: '20'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 500
    - 116.0
    rotation: 0
    state: enabled
- name: time_srate
  id: variable
  parameters:
    comment: Sampling rate specifically for time domain block (20 Msps)
    value: samp_rate * time_interp
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 620
    - 116.0
    rotation: 0
    state: enabled
- name: tone_bw
  id: variable
  parameters:
    comment: 'Half-width of the band kept around the tone, Hz.

      Narrow enough to reject DC and most of the noise, wide

      enough to tolerate the B210/X310 reference offset, which

      measured ~3.9 kHz at 2.4 GHz. 10 kHz halves the noise

      power the phase estimator sees versus the old 25 kHz.'
    value: 10e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1872
    - 108.0
    rotation: 0
    state: enabled
- name: tone_offset
  id: variable
  parameters:
    comment: 'Baseband offset of the calibration tone, Hz.

      MUST match b210_tone_source.py --offset (default +200 kHz).

      Set 0 only if your source really is at the centre frequency,

      which makes it indistinguishable from LO leakage.'
    value: 200e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1544
    - 212.0
    rotation: 0
    state: enabled
- name: tone_taps
  id: variable
  parameters:
    comment: Low-pass prototype for the translating filter.
    value: firdes.low_pass(1.0, samp_rate, tone_bw, tone_bw/2.0, firdes.WIN_HAMMING)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 960
    - 292.0
    rotation: 0
    state: enabled
- name: tx_control
  id: variable
  parameters:
    comment: 'hackrf_tone_source.py control socket. The transmitter is told to

      retune first, so it is already there when we arrive.

      Set to '''' to leave the transmitter alone.'
    value: '''127.0.0.1:5123'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1128
    - 252.0
    rotation: 0
    state: enabled
- name: tx_disp_gain
  id: variable
  parameters:
    comment: 'Display-only gain for the black TX reference trace.

      The B210 TX sink in this flowgraph is DISABLED -- the real

      transmitter is b210_tone_source.py -- so this scales the

      on-screen trace only and cannot change radiated power.'
    value: '10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1360
    - 8
    rotation: 0
    state: enabled
- name: view_decim
