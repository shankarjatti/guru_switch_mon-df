diff --git a/CMakeLists.txt b/CMakeLists.txt
index a5d468d..8df2f03 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -20,7 +20,7 @@
 ########################################################################
 # Project setup
 ########################################################################
-cmake_minimum_required(VERSION 2.6)
+cmake_minimum_required(VERSION 3.8)
 project(gr-doa CXX C)
 enable_testing()
 
@@ -33,6 +33,15 @@ set(CMAKE_BUILD_TYPE ${CMAKE_BUILD_TYPE} CACHE STRING "")
 
 #make sure our local CMake Modules path comes first
 list(INSERT CMAKE_MODULE_PATH 0 ${CMAKE_SOURCE_DIR}/cmake/Modules)
+# GR 3.8 port: force GR 3.8's headers ahead of the system GR 3.10 in
+# /usr/include.  Without this, sptr_magic.h comes from 3.10 (std::shared_ptr)
+# while the doa headers declare boost::shared_ptr, and every block fails to
+# compile with a get_initial_sptr conversion error.
+include_directories(BEFORE $ENV{GR38_DIR}/include $ENV{UHD315_DIR}/include)
+link_directories($ENV{GR38_DIR}/lib $ENV{UHD315_DIR}/lib)
+# GR 3.8 port: GR's own cmake modules must be reachable BEFORE
+# include(GrPlatform) at line ~69; find_package(Gnuradio) runs later.
+list(APPEND CMAKE_MODULE_PATH $ENV{GR38_DIR}/lib/cmake/gnuradio)
 
 ########################################################################
 # Compiler specific setup
@@ -118,7 +127,7 @@ find_package(Doxygen)
 # caps such as FILTER or FFT) and change the version to the minimum
 # API compatible version required.
 set(GR_REQUIRED_COMPONENTS RUNTIME)
-find_package(Gnuradio "3.7.2" REQUIRED)
+find_package(Gnuradio "3.8" REQUIRED)
 list(INSERT CMAKE_MODULE_PATH 0 ${CMAKE_SOURCE_DIR}/cmake/Modules)
 
 if(NOT CPPUNIT_FOUND)
