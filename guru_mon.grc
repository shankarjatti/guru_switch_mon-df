    label0: 900 MHz (ch0)
    option1: '2400000000.0'
    label1: 2400 MHz (ch1)
    option2: '5200000000.0'
    label2: 5200 MHz (ch2)
    option3: '5800000000.0'
    label3: 5800 MHz (ch3)
    option4: '4'
