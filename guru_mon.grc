- name: snippet_mon_setup
  id: snippet
  parameters:
    section: main_after_init
    priority: '0'
    code: '# MON mode, in order: export off, all LOs internal, tune each channel twice

      self._mon_setup = mon_tools.mon_setup(self.uhd_usrp_source_0, [self.f0, self.f1, self.f2, self.f3],
      [self.g0, self.g1, self.g2, self.g3])

      '
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 700
    rotation: 0
    state: enabled
- name: snippet_mon_poll
  id: snippet
  parameters:
    section: main_after_start
    priority: '0'
    code: "# Twice a second: every channel's own lock sensor, samples counted, stream\n# breaks, strongest\
      \ line of the newest 8192 samples, ADC peak. Every 5 s the\n# same line goes to the log.\nimport\
      \ time\nfrom PyQt5 import QtCore\n\nself._mon_last_log = 0.0\nFS = float(self.samp_rate)\n\ndef\
      \ _mon_poll():\n    m = self.mon_meter\n    now = time.monotonic()\n    el = (now - m.t_first) if\
      \ m.t_first else 0.0\n    log = now - self._mon_last_log >= 5.0\n    for c in range(4):\n      \
      \  lk = mon_tools.lo_locked(self.uhd_usrp_source_0, c)\n        lock = \"LOCKED\" if lk else (\"\
      LOCK UNKNOWN\" if lk is None else \"NOT LOCKED\")\n        brk = max(m.rx_time_tags[c] - 1, 0)\n\
      \        txt = \"%s | %.4f GHz | samples %d (%.3f MS/s) | stream breaks %d\" % (\n            lock,\
      \ self.uhd_usrp_source_0.get_center_freq(c) / 1e9, m.count[c],\n            (m.count[c] / el / 1e6)\
      \ if el > 0 else 0.0, brk)\n        x = m.snap[c]\n        if x is not None:\n            r = mon_tools.readout(x,\
      \ FS)\n            txt += \" | newest %d samples: %s %+.1f kHz %.1f dB | ADC peak %.3f%s\" % (len(x),\n\
      \                \"TONE\" if r[\"tone\"] else \"no tone, strongest line\", r[\"f\"] / 1e3, r[\"\
      db\"],\n                r[\"peak\"], \"  OVERLOAD\" if r[\"peak\"] > 0.5 else \"\")\n        getattr(self,\
      \ \"set_mon%d\" % c)(txt)\n        if log:\n            print(\"[mon] %s ch%d %s\" % (time.strftime(\"\
      %H:%M:%S\"), c, txt))\n    if log:\n        self._mon_last_log = now\n    m.request()\n\nself._mon_timer\
      \ = QtCore.QTimer()\nself._mon_timer.timeout.connect(_mon_poll)\nself._mon_timer.start(500)\n"
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 800
    rotation: 0
    state: enabled
