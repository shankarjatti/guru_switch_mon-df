options:
  parameters:
    author: shankar
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: 'MON mode: 4 TwinRX channels, each on its OWN internal LO, one band each.

      GNU Radio 3.8 / UHD 3.15. Everything shown is measured on the RX.'
    copyright: ''
    description: 'Monitoring: 4 independent LOs'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: guru_mon
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'Guru MON: USRP-2945, every channel its own LO and band (monitoring)'
    window_size: 1700,1000
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: '2000000'
    comment: ''
  states:
