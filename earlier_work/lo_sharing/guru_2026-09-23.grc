- name: twinrx_hopping_source_0
  id: twinrx_hopping_source
  parameters:
    addresses: '"type=x300"'
    affinity: ''
    alias: ''
    blank_during_settle: 'False'
    comment: |-
      Bands 2.4 / 5.2 / 5.8 GHz. None of them needs the LO fallback: 5.2 GHz
      uses a low-side LO natively, unlike 5.1 GHz where UHD picks a high-side
      LO the synthesiser will not re-lock to. So no forced re-lock, no mirrored
      spectrum, and no 180 degree step on the exporting channel.

      LO must be exported by Rx B: the A->B MMCX jumpers pass no LO, so
      direction 'A' leaves ch2/ch3 with no oscillator and two flat traces.
    cpu_format: fc32
    dwell_0: '10.0'
    dwell_1: '10.0'
    dwell_2: '10.0'
    dwell_3: '10.0'
    dwell_4: '10.0'
    dwell_5: '10.0'
    dwell_6: '10.0'
    dwell_7: '10.0'
    freq_0: '2400000000'
    freq_1: '5200000000'
    freq_2: '5800000000'
    freq_3: '2400000000'
    freq_4: '2400000000'
    freq_5: '2400000000'
    freq_6: '2400000000'
    freq_7: '2400000000'
    gain_0: '46'
    gain_1: '60'
    gain_2: '69'
    gain_3: '60'
    gain_4: '60'
    gain_5: '60'
    gain_6: '60'
    gain_7: '60'
    hop_enable: 'True'
    lo_export_direction: B
    lo_lock_fallback: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_bands: '3'
    otw_format: ''
    samp_rate: '1000000'
    settle: '1.0'
    sources: '4'
    start_delay: '2.0'
    tx_control: '"127.0.0.1:5123"'
    gain_trim: (0.0, -13.3, 1.5, -1.7)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
