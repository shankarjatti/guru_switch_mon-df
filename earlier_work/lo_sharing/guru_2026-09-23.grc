- name: qtgui_freq_sink_x_0
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: samp_rate
    comment: |-
      Wideband view of what each channel actually receives: the tone,
      any LO leakage left after the DC blocker, and the noise floor.
      Taken before the display band-pass, so it shows the whole
      1 MHz span rather than just the tone.
    ctrlpanel: 'False'
    fc: center_freq
    fftsize: '4096'
    freqhalf: 'False'
    grid: 'True'
    gui_hint: tabs@1:0,0,1,2
    legend: 'True'
    name: '"Spectrum - all 4 channels (DC removed)"'
    nconnections: '4'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.10'
    wintype: firdes.WIN_BLACKMAN_hARRIS
    ymax: '-20'
    ymin: '-140'
    label: Relative Gain
    label1: Ch0 RF A/RX1
