options:
  parameters:
    author: shankar
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: 'USRP-2945 (X310 + 2x TwinRX) LO configuration and phase-coherence test.

      GNU Radio 3.8 / UHD 3.15.

      All four channels are driven from ONE synthesiser, tuned with timed commands.'
    copyright: ''
    description: TwinRX LO sharing / phase coherence test bench
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: twinrx_lo_coherence
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'USRP-2945 / TwinRX: LO Configuration & Phase Coherence'
    window_size: 1400,900
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: avg_len
  id: variable
  parameters:
    comment: 'Coherent averaging length for the phase estimate.

      65536 samples = 65 ms at 1 Msps, comparable to what

      twinrx_lo_check.py integrates. The old 4096 averaged 24x

      less and made the GUI look far noisier than the CLI for

      the same signal.'
    value: '65536'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 344
    - 116.0
    rotation: 0
    state: enabled
- name: center_freq
  id: variable_qtgui_range
  parameters:
    comment: 'Moving this slider triggers a full coherent

      retune (timed, twice) via the watcher thread.'
    gui_hint: tabs@0:0,0,1,1
    label: Center Freq (Hz)
    min_len: '200'
    orient: Qt.Horizontal
    rangeType: float
    start: 10e6
    step: 1e6
    stop: 6e9
    value: 2.4e9
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1008
    - 92.0
    rotation: 0
    state: enabled
- name: cmd_lead
  id: variable
  parameters:
    comment: 'How far ahead of "now" the timed tune is scheduled.

      Must exceed the host->FPGA latency. 0.1 s is safe.'
    value: '0.1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 284.0
    rotation: 0
    state: enabled
- name: dsp_manual
  id: variable
  parameters:
    comment: 'True  -> force every DDC to 0 Hz so the digital

      down-conversion adds no per-channel phase.

      Set False if you need exact requested centre freq.'
    value: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 356.0
    rotation: 0
    state: enabled
- name: gain
  id: variable_qtgui_range
  parameters:
    comment: TwinRX gain range is 0 .. 93 dB.
    gui_hint: tabs@0:1,0,1,1
    label: RX Gain (dB)
    min_len: '100'
    orient: Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '93'
    value: '60'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 800
    - 20.0
    rotation: 0
    state: enabled
- name: lo_export_chan
  id: variable
  parameters:
    comment: 'Channel whose synthesiser feeds everything else.

      0 = DB-A ch0 exports (cables A->B)  -- NOT WORKING on this unit

      2 = DB-B ch0 exports (cables B->A)  -- verified working'
    value: '2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 116.0
    rotation: 0
    state: enabled
- name: lo_sources
  id: variable
  parameters:
    comment: 'Per-channel LO source, index = UHD channel.

      Master board : exporter = internal (or reimport), partner = companion

      Slave  board : BOTH channels = external

      Valid: internal / companion / external / reimport / disabled

      Rx B exports here, not Rx A. Measured on this unit the jumpers

      carrying A LO-out to B LO-in pass nothing, while B to A works.

      Swap back to [internal, companion, external, external] with

      lo_export_chan 0 if those cables get repaired.'
    value: '[''external'', ''external'', ''internal'', ''companion'']'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 188.0
    rotation: 0
    state: enabled
- name: ref_offset
  id: variable
  parameters:
    comment: 'An off-tone frequency inside the same passband.

      Comparing tone power against power here is what tells a real

      signal from LO leakage or crosstalk. A channel reading ~0 dB

      on this ratio is NOT receiving, however steady its phase.'
    value: tone_offset + 53e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1376
    - 292.0
    rotation: 0
    state: disabled
- name: samp_rate
  id: variable
  parameters:
    comment: 'Per-channel rate. 1 Msps x 4ch is easy on 10GbE

      and plenty for a phase-coherence check.'
    value: '1000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 116.0
    rotation: 0
    state: enabled
- name: subdev
  id: variable
  parameters:
    comment: 'DB-A = TwinRX #1 (ch0, ch1)

      DB-B = TwinRX #2 (ch2, ch3)'
    value: '"A:0 A:1 B:0 B:1"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 180.0
    rotation: 0
    state: enabled
- name: time_interp
  id: variable
  parameters:
    comment: Interpolation factor for time domain block
    value: '20'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 500
    - 116.0
    rotation: 0
    state: enabled
- name: time_srate
  id: variable
  parameters:
    comment: Sampling rate specifically for time domain block (20 Msps)
    value: samp_rate * time_interp
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 620
    - 116.0
    rotation: 0
    state: enabled
- name: tone_bw
  id: variable
  parameters:
    comment: 'Half-width of the band kept around the tone, Hz.

      Narrow enough to reject DC and most of the noise, wide

      enough to tolerate the B210/X310 reference offset, which

      measured ~3.9 kHz at 2.4 GHz. 10 kHz halves the noise

      power the phase estimator sees versus the old 25 kHz.'
    value: 10e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 920
    - 580.0
    rotation: 0
    state: enabled
- name: tone_offset
  id: variable
  parameters:
    comment: 'Baseband offset of the calibration tone, Hz.

      MUST match b210_tone_source.py --offset (default +200 kHz).

      Set 0 only if your source really is at the centre frequency,

      which makes it indistinguishable from LO leakage.'
    value: 200e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 920
    - 492.0
    rotation: 0
    state: enabled
- name: tone_taps
  id: variable
  parameters:
    comment: Low-pass prototype for the translating filter.
    value: firdes.low_pass(1.0, samp_rate, tone_bw, tone_bw/2.0, firdes.WIN_HAMMING)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1080
    - 492.0
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable_qtgui_range
  parameters:
    comment: B210 TX gain range is 0 .. 60 dB. Safe ceiling 60 dB.
    gui_hint: tabs@0:1,1,1,1
    label: TX Gain (dB)
    min_len: '100'
    orient: Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '60'
    value: '50'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1080
    - 412.0
    rotation: 0
    state: disabled
- name: view_decim
  id: variable
  parameters:
    comment: Decimation before the GUI sinks.
    value: '2048'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 344
    - 180.0
    rotation: 0
    state: enabled
