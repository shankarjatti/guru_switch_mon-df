- name: bpf_0
  id: freq_xlating_fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    center_freq: tone_offset
    comment: 'Shift the tone to DC and throw away everything else --

      crucially the real DC term, which carries LO self-mixing

      leakage and would otherwise dominate the phase estimate.'
    decim: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    taps: tone_taps
    type: ccc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 808
    - 444.0
    rotation: 0
    state: disabled
