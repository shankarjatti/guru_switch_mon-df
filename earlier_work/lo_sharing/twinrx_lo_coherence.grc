    label4: ch3 RF B/RX2
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    max: '50'
    min: '-10'
    name: '"IS THIS CHANNEL RECEIVING?  above 6 dB = YES.  near 0 dB = NO"'
    nconnections: '4'
    type: float
    unit1: dB
    unit10: ''
    unit2: dB
    unit3: dB
    unit4: dB
    unit5: ''
    unit6: ''
